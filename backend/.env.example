# MailLens Backend Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (leave blank to auto-use in-memory MongoDB)
MONGODB_URI=

# Google Gemini API Key (Optional: fallbacks to built-in heuristic NLP if empty)
GEMINI_API_KEY=

# Google OAuth 2.0 Credentials (for real Gmail connection)
# Generate in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Client URL (React Frontend)
CLIENT_URL=http://localhost:5173
